# Graph nodes and their weighted edges
graph = {
    'A': [('B', 6), ('C', 3)],
    'B': [('A', 6), ('C', 2), ('D', 5)],
    'C': [('A', 3), ('B', 2), ('D', 3), ('E', 4)],
    'D': [('B', 5), ('C', 3), ('E', 3), ('F', 7)],
    'E': [('C', 4), ('D', 3), ('F', 2), ('G', 5)],
    'F': [('D', 7), ('E', 2), ('G', 2)],
    'G': [('E', 5), ('F', 2)]
}

# Heuristic distances
h_dist = {
    'A': 11,
    'B': 6,
    'C': 5,
    'D': 7,
    'E': 3,
    'F': 6,
    'G': 0
}

def a_star(start, stop):
    open_set = set([start])
    closed_set = set()
    g = {}
    parents = {}
    g[start] = 0
    parents[start] = start

    while len(open_set) > 0:
        n = None
        # Find node with lowest f() value
        for v in open_set:
            if n is None or g[v] + h_dist[v] < g[n] + h_dist[n]:
                n = v

        if n is None:
            print("Path does not exist!")
            return None

        if n == stop:
            path = []
            while parents[n] != n:
                path.append(n)
                n = parents[n]
            path.append(start)
            path.reverse()
            print("Path found:", path)
            return path

        for (m, weight) in graph.get(n, []):
            if m not in open_set and m not in closed_set:
                open_set.add(m)
                parents[m] = n
                g[m] = g[n] + weight
            else:
                if g[m] > g[n] + weight:
                    g[m] = g[n] + weight
                    parents[m] = n
                    if m in closed_set:
                        closed_set.remove(m)
                        open_set.add(m)

        open_set.remove(n)
        closed_set.add(n)

    print("Path does not exist!")
    return None

# Example usage
a_star('A', 'G')
