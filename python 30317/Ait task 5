import numpy as np
import random

n_ants = 10
n_best = 5
n_iterations = 100
decay = 0.95
alpha = 1
beta = 2

distance_matrix = np.array([
    [0, 10, 15, 20, 25],
    [10, 0, 35, 25, 17],
    [15, 35, 0, 30, 28],
    [20, 25, 30, 0, 23],
    [25, 17, 28, 23, 0]
])

n = len(distance_matrix)
pheromone = np.ones((n, n))
all_inds = range(n)

def pick_move(pheromone_row, dist_row, visited):
    pheromone_row = np.copy(pheromone_row)
    pheromone_row[list(visited)] = 0
    row = pheromone_row ** alpha * ((1.0 / dist_row) ** beta)
    norm_row = row / row.sum()
    move = np.random.choice(all_inds, 1, p=norm_row)[0]
    return move

def gen_path(start):
    path = []
    visited = set([start])
    prev = start
    for _ in range(n - 1):
        move = pick_move(pheromone[prev], distance_matrix[prev], visited)
        path.append((prev, move))
        prev = move
        visited.add(move)
    path.append((prev, start))
    return path

def path_distance(path):
    total = 0
    for (i, j) in path:
        total += distance_matrix[i][j]
    return total

for iteration in range(n_iterations):
    all_paths = []
    for i in range(n_ants):
        path = gen_path(random.randint(0, n - 1))
        all_paths.append((path, path_distance(path)))
    all_paths.sort(key=lambda x: x[1])
    best_paths = all_paths[:n_best]
    pheromone *= decay
    for path, dist in best_paths:
        for (i, j) in path:
            pheromone[i][j] += 1.0 / dist

best_path = min(all_paths, key=lambda x: x[1])[0]
best_distance = min(all_paths, key=lambda x: x[1])[1]

print("Best path:", best_path)
print("Best distance:", best_distance)
